<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:implementationMode="performance"
        app:scaleType="fillCenter" />

    <de.codinix.videoeditor.overlay.OverlayGestureView
        android:id="@+id/gestureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <de.codinix.videoeditor.SegmentProgressView
        android:id="@+id/segmentBar"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_pill"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:text="@string/ready"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/segmentBar" />

    <LinearLayout
        android:id="@+id/tipCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="72dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText">

        <TextView
            android:id="@+id/tipText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F2FFFFFF"
            android:textSize="13sp" />

        <de.codinix.videoeditor.GestureHintView
            android:id="@+id/tipGesture"
            android:layout_width="120dp"
            android:layout_height="52dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <!-- Rechte Seitenleiste (scrollbar) -->
    <ScrollView
        android:id="@+id/rightBar"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:fadingEdgeLength="24dp"
        app:layout_constraintBottom_toTopOf="@id/recordButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsButton">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <ImageButton
            android:id="@+id/flipButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/flip_camera"
            android:src="@drawable/ic_flip_camera" />

            <TextView
            android:id="@+id/qualityButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/quality"
            android:gravity="center"
            android:text="…"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

            <ImageButton
            android:id="@+id/filterButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/filter"
            android:src="@drawable/ic_filter" />

            <ImageButton
            android:id="@+id/addImageButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/add_image"
            android:src="@drawable/ic_add_image" />

            <ImageButton
            android:id="@+id/addVideoButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/add_video"
            android:src="@drawable/ic_add_video" />

            <ImageButton
            android:id="@+id/addTextButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/add_text"
            android:src="@drawable/ic_text" />

            <ImageButton
            android:id="@+id/greenscreenButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/greenscreen"
            android:src="@drawable/ic_person_bg" />

            <ImageButton
            android:id="@+id/mosaicButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/mosaic"
            android:src="@drawable/ic_mosaic" />

            <ImageButton
            android:id="@+id/micButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/mic_volume"
            android:src="@drawable/ic_mic" />

            <ImageButton
            android:id="@+id/previewSoundButton"
            android:layout_width="52dp"
            android:layout_marginBottom="10dp"
            android:layout_height="52dp"
            android:alpha="0.5"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/preview_sound"
            android:src="@drawable/ic_headphones" />

        </LinearLayout>
    </ScrollView>
    

    

    

    

    

    

    <ImageButton
        android:id="@+id/soundButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/sound_on"
        android:src="@drawable/ic_volume_on"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="132dp"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <ImageButton
        android:id="@+id/draftsButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/drafts"
        android:src="@drawable/ic_folder"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    

    

    <ImageButton
        android:id="@+id/shapeButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="186dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/shape"
        android:src="@drawable/ic_shape"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <ImageButton
        android:id="@+id/borderButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="240dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/border_toggle"
        android:src="@drawable/ic_border"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    

    <ImageButton
        android:id="@+id/tileMediaButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="78dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/tile_media"
        android:src="@drawable/ic_add_image"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <ImageButton
        android:id="@+id/tileCameraButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="132dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/tile_camera"
        android:src="@drawable/ic_camera_back"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <ImageButton
        android:id="@+id/tileFillButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="186dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/tile_fill"
        android:src="@drawable/ic_fill"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <ImageButton
        android:id="@+id/tileVideoButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="240dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/tile_video"
        android:src="@drawable/ic_add_video"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <ImageButton
        android:id="@+id/tileSoundButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="294dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/overlay_volume_title"
        android:src="@drawable/ic_overlay_volume"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <ImageButton
        android:id="@+id/editTextButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/edit_text"
        android:src="@drawable/ic_edit"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="186dp"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <ImageButton
        android:id="@+id/removeOverlayButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_round_button_accent"
        android:contentDescription="@string/remove_overlay"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        android:layout_marginTop="78dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusText" />

    <!-- Untere Leiste -->
    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="36dp"
        android:background="@drawable/bg_round_button"
        android:contentDescription="@string/delete_last"
        android:src="@drawable/ic_backspace"
        app:layout_constraintBottom_toBottomOf="@id/recordButton"
        app:layout_constraintEnd_toStartOf="@id/recordButton"
        app:layout_constraintTop_toTopOf="@id/recordButton" />

    <View
        android:id="@+id/recordButton"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:layout_marginBottom="44dp"
        android:background="@drawable/bg_record_button"
        android:contentDescription="@string/record"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/finishButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="36dp"
        android:background="@drawable/bg_round_button_accent"
        android:contentDescription="@string/finish"
        android:src="@drawable/ic_check"
        app:layout_constraintBottom_toBottomOf="@id/recordButton"
        app:layout_constraintStart_toEndOf="@id/recordButton"
        app:layout_constraintTop_toTopOf="@id/recordButton" />

    <include
        android:id="@+id/review"
        layout="@layout/view_review"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
